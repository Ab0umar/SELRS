NODE_ENV=development
# Unified auto reply: server-only credentials. Never use VITE_ for these values.
AUTO_REPLY_WORKER_ENABLED=false
AUTO_REPLY_WEBHOOK_DIAGNOSTICS=false
AUTO_REPLY_META_APP_ID=
AUTO_REPLY_META_APP_SECRET=
AUTO_REPLY_VERIFY_TOKEN=
# Set a supported Graph version from your Meta app dashboard, e.g. v25.0 after verification.
AUTO_REPLY_META_GRAPH_VERSION=
AUTO_REPLY_WHATSAPP_PHONE_ID=
AUTO_REPLY_WHATSAPP_WABA_ID=
AUTO_REPLY_WHATSAPP_TOKEN=
AUTO_REPLY_PAGE_ID=
AUTO_REPLY_PAGE_TOKEN=
AUTO_REPLY_PAGE_NAME=
AUTO_REPLY_PAGE_2_ID=
AUTO_REPLY_PAGE_2_TOKEN=
AUTO_REPLY_PAGE_2_NAME=
AUTO_REPLY_GEMINI_KEY=
PORT=4000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://selrs.cc
APP_VERSION=
BUILD_TIME=
GIT_COMMIT=

# MySQL connection string
DATABASE_URL=mysql://root:password@127.0.0.1:3306/selrs_db

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional: dedicated key for tokens stored in the database (Facebook page tokens).
# Falls back to a key derived from JWT_SECRET. If you rotate whichever one is in use,
# the stored tokens can no longer be decrypted and the pages must be reconnected.
SECRETS_ENCRYPTION_KEY=

# Android release signing (keep empty here; configure only on the build machine)
ANDROID_STORE_FILE=
ANDROID_STORE_PASSWORD=
ANDROID_KEY_ALIAS=release
ANDROID_KEY_PASSWORD=

# Optional app settings
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: Firebase Cloud Messaging for true background push notifications
# Use either FCM_SERVICE_ACCOUNT_JSON (full JSON string) or the three vars below.
# Android client also requires android/app/google-services.json from the same Firebase project.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# Optional: MSSQL patient sync (source of truth from accounting system)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_AUTH_MODE=sql
# For Windows auth mode, install msnodesqlv8 and set this full ODBC connection string:
# MSSQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=192.168.0.100,1433;Database=op2026;Trusted_Connection=Yes;TrustServerCertificate=Yes;
MSSQL_CONNECTION_STRING=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# Optional custom query. If empty, defaults to selecting standard patient columns from Patients table.
MSSQL_PATIENTS_QUERY=
MSSQL_SYNC_LIMIT=5000
# Auto sync every interval (milliseconds)
MSSQL_SYNC_AUTO=false
MSSQL_SYNC_INTERVAL_MS=300000
MSSQL_SYNC_INCREMENTAL_AUTO=true
MSSQL_SYNC_UPDATE_EXISTING=false
MSSQL_SYNC_PRESERVE_MANUAL_EDITS=true
MSSQL_SYNC_LINK_SERVICES_FOR_EXISTING=true
MSSQL_PUSH_CREATE_SERVICE_ROW=false
MSSQL_PUSH_DEDUP_SECONDS=90
# Optional doctor-code CSV mapping (default: ./MD.csv with CODE;PHNM_AR)
MSSQL_DOCTOR_MAP_CSV=

# Optional: Black Ice folder -> MySQL importer (for builds where ODBC upload SQL is incompatible)
# Defaults to ./Pentacam if not set.
BLACKICE_IMPORT_ENABLED=true
BLACKICE_IMPORT_SOURCE_DIR=E:/Web.selrs.cc/Pentacam/incoming
BLACKICE_IMPORT_PROCESSED_DIR=
BLACKICE_IMPORT_FAILED_DIR=
BLACKICE_IMPORT_SOURCE_PRINTER=Pentacam
BLACKICE_IMPORT_POLL_MS=10000
BLACKICE_IMPORT_MIN_FILE_AGE_MS=5000
BLACKICE_IMPORT_MAX_FILES_PER_CYCLE=20

# Optional: OCR + auto-link uploads to patients by extracted numeric IDs
BLACKICE_OCR_ENABLED=false
BLACKICE_OCR_POLL_MS=20000
BLACKICE_OCR_BATCH_SIZE=10
BLACKICE_OCR_TESSERACT_PATH=tesseract
BLACKICE_OCR_LANG=eng
BLACKICE_OCR_PSM=6

# K40 Pro ADMS device clock correction (see docs/ATTENDANCE_SYNC.md, section
# "Time zones and device clock offsets"). The device clock runs hours ahead of
# local time by a hidden firmware timezone delta that has changed over time;
# never hardcode it here.
# ZK_ADMS_PUNCH_OFFSET_HOURS: hours the device is AHEAD, subtracted from every
#   ADMS punch before storage. Setting it overrides and disables per-device
#   auto-detection. Leave it empty to auto-detect from fresh punches.
ZK_ADMS_PUNCH_OFFSET_HOURS=6
# ZK_ADMS_DEVICE_TZ_OFFSET: Deprecated. No code reads this variable anymore
#   (the handshake Date header is no longer adjusted, and the punch offset
#   defaults to 0 until auto-detected). The line is kept so existing .env
#   files stay valid; it can be deleted.
ZK_ADMS_DEVICE_TZ_OFFSET=9
# ADMS has no protocol authentication. Each entry must pair a device serial with
# its source IP as SERIAL@IP; separate multiple devices with commas. Empty means
# all /iclock endpoints deny requests. If ADMS is behind a proxy, allowlist the
# proxy peer and restrict access to /iclock at that proxy/firewall as well.
# Exact serial@source-IP pairs, comma-separated. Empty/unset denies all /iclock requests.
ZK_ADMS_DEVICE_ALLOWLIST=

# EF10K (FK) TCP device connection — ip/port/comm key are read from these env vars
# only (never from the DB/Settings UI), so device wiring lives in one place.
ATTENDANCE_DEVICE_ENABLED=true
ATTENDANCE_DEVICE_IP=192.168.0.10
ATTENDANCE_DEVICE_PORT=5005
ATTENDANCE_DEVICE_COMM_KEY=0

# K40 Pro (ZK) TCP device connection — matches FK's DEVICE_IP/PORT pattern
ZK_DEVICE_ENABLED=true
ZK_DEVICE_IP=192.168.0.10
ZK_DEVICE_PORT=4370
ZK_COMM_KEY=0
# ZK_USE_LEGACY_PULLER: true = old PowerShell+COM path (win32-only), false/unset = pure TCP client
ZK_USE_LEGACY_PULLER=false
# K40 device clock re-sync interval (minutes), TCP mode only
ZK_CLOCK_SYNC_INTERVAL_MINUTES=2
WHATSAPP_SUPPORT_NUMBER=01285800309
MANUS_API_KEY=
WHATSAPP_MARKETING_TEMPLATE=selrs_whats
WHATSAPP_MARKETING_OPT_IN_TEMPLATE=selrs_whats
# Coexistence: generate 32 random bytes encoded as 64 hexadecimal characters on server.
AUTO_REPLY_CREDENTIAL_KEY=
AUTO_REPLY_CREDENTIAL_FILE=.auto-reply/whatsapp.enc
AUTO_REPLY_EMBEDDED_SIGNUP_CONFIG_ID=
AUTO_REPLY_PUBLIC_ORIGIN=https://selrs.cc
AUTO_REPLY_COEXISTENCE_ENABLED=false
