{
  "name": "SELRS",
  "version": "1.0.176",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:sync": "powershell -ExecutionPolicy Bypass -File ./sync-version.ps1",
    "dist": "npm run dist:sync && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cc.selrs.electron",
    "productName": "SELRS",
    "directories": {
      "output": "E:\\selrs.cc\\desktop-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "http://192.168.1.100:4000/updates"
    },
    "win": {
      "icon": "assets/app.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SELRS",
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeaderIcon": "assets/app.ico",
      "artifactName": "SELRS-Electron-Setup-${version}.${ext}"
    }
  }
}
