{
    "name":  "SELRS",
    "version":  "1.1.92",
    "private":  true,
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "dist:sync":  "powershell -ExecutionPolicy Bypass -File ./sync-version.ps1",
                    "dist":  "npm run dist:sync \u0026\u0026 electron-builder --win nsis"
                },
    "dependencies":  {
                         "@rollup/plugin-typescript":  "11.1.6",
                         "@typescript/typescript-aix-ppc64":  "7.0.2",
                         "@typescript/typescript-darwin-arm64":  "7.0.2",
                         "ajv":  "8.20.0",
                         "boolean":  "3.2.0",
                         "electron-updater":  "^6.8.9",
                         "ts-node":  "10.9.2",
                         "tsify":  "5.0.4",
                         "typescript":  "^7.0.2"
                     },
    "devDependencies":  {
                            "electron":  "^44.4.3",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "appId":  "cc.selrs.electron",
                  "productName":  "SELRS",
                  "directories":  {
                                      "output":  "E:\\selrs.cc\\desktop-electron"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "dist/**/*"
                            ],
                  "publish":  {
                                  "provider":  "generic",
                                  "url":  "http://192.168.1.100:4000/updates"
                              },
                  "win":  {
                              "icon":  "assets/app.ico",
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "SELRS",
                               "installerIcon":  "assets/app.ico",
                               "uninstallerIcon":  "assets/app.ico",
                               "installerHeaderIcon":  "assets/app.ico",
                               "artifactName":  "SELRS-Electron-Setup-${version}.${ext}"
                           }
              }
}