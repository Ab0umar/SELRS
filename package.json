{
  "name": "SELRS",
  "version": "1.1.84",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "pentacam:service": "cross-env tsx server/services/pentacam.ts",
    "pentacam:service:watch": "cross-env tsx watch server/services/pentacam.ts",
    "sync:year2023": "cross-env tsx server/integrations/syncYearPatients.ts 2023",
    "sync:year2024": "cross-env tsx server/integrations/syncYearPatients.ts 2024",
    "sync:year2025": "cross-env tsx server/integrations/syncYearPatients.ts 2025",
    "check:encoding": "node scripts/check-mojibake.mjs",
    "build": "pnpm check:encoding && vite build && node scripts/fix-legacy-media-queries.mjs && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:watch": "cross-env FAST_BUILD=1 vite build && node scripts/fix-legacy-media-queries.mjs && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:server:watch": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "dev:prod-watch": "node scripts/watch-build-start.mjs",
    "check": "tsc --noEmit",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:sync-check": "tsx scripts/check-db-sync.ts",
    "perms:backfill": "tsx scripts/backfill-inherited-permissions.ts",
    "security:audit-users": "tsx scripts/audit-users.ts",
    "db:migration-files-check": "tsx scripts/check-migration-files.ts",
    "security:trpc-inventory": "node scripts/inventory-trpc-procedures.mjs",
    "s3:audit-versions": "node scripts/audit-s3-versions.mjs",
    "db:ensure-admin-active": "tsx scripts/ensure-active-admin.ts",
    "db:sync-user-permissions-to-role": "tsx scripts/sync-user-permissions-to-role.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-db.ps1",
    "s3:preview-dedup": "tsx scripts/preview-dedup-srv100.ts",
    "s3:dedup-srv100": "tsx scripts/deduplicate-srv100.ts",
    "s3:dedup-batch": "tsx scripts/deduplicate-srv100-batch.ts",
    "s3:dedup-simple": "tsx scripts/deduplicate-simple.ts",
    "s3:migrate-srv100": "tsx scripts/migrate-srv100-to-s3.ts",
    "create-user": "tsx scripts/createUser.ts",
    "templates:export-ready-prescriptions": "tsx scripts/export-ready-prescriptions-to-excel.ts",
    "templates:convert-multisheet": "node scripts/convert-ready-prescriptions-to-multisheet.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "android:build-release": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "security:files": "node scripts/check-sensitive-files.mjs",
    "web:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-web.ps1",
    "postinstall": "node scripts/postinstall.mjs"
  },
